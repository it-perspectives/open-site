{
  "name": "@it-perspectives/opensite",
  "version": "0.1.0",
  "description": "Framework-independent OpenSite website contracts, JSON Schema, and validator for QA",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/it-perspectives/open-site.git"
  },
  "bin": {
    "opensite": "bin/opensite.js"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./schema": "./schemas/opensite-0.1.0.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "examples",
    "docs",
    "SPEC.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:types": "tsc -p test/types/tsconfig.json",
    "lint": "node bin/opensite.js lint examples/opensite.yaml examples/opensite.json --warnings-as-errors",
    "verify": "npm test && npm run test:types && npm run lint",
    "release:prepare": "npm run verify && node scripts/prepare-release.js",
    "prepack": "npm run verify",
    "deploy": "node scripts/deploy.js",
    "tooling:smoke-npm": "node scripts/smoke-package.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
